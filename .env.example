# dagster-quickstart environment variables.
#
# Copy this file to `.env` and fill in real values. Every entry marked
# REQUIRED must be set or the corresponding asset will refuse to start.
# Optional entries fall back to the defaults noted alongside.
#
# The file is loaded via python-dotenv from the dagster-quickstart repo
# root (see load_dotenv(...) calls in each asset module).

# ─── ReliefWeb ingest ────────────────────────────────────────────────
# App name registered with ReliefWeb's API. Any non-empty string works
# for public endpoints; they use it for rate-limiting / analytics.
RELIEFWEB_APPNAME=

# ─── S3 / object store ──────────────────────────────────────────────
# Any S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO, etc.). All
# five values are REQUIRED — the assets fail loud on missing creds
# rather than silently swallowing writes.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── clear-api ──────────────────────────────────────────────────────
# All DB access (location resolver + knowledgebase upsert) routes
# through clear-api's GraphQL, matching the clear-pipeline pattern.
# CLEAR_API_KEY must belong to a user with the `admin` or `pipeline`
# role — issue one via `createApiKey` in clear-api. REQUIRED.
CLEAR_API_URL=http://localhost:4000/graphql
CLEAR_API_KEY=

# ─── Location-metadata ingests (HAPI daily, IOM DTM monthly) ─────────
# Refresh the locationMetadata context layer in clear-api from external
# humanitarian APIs, for every country in clear-api's `pipelineCountries`.
# Jobs: location_metadata_daily (HAPI + OCHA 3W), location_metadata_monthly
# (IOM DTM). Both write via upsertLocationMetadataBatch (needs the admin/pipeline
# CLEAR_API_KEY above).

# HAPI (HDX Humanitarian API) app identifier — base64 `email:app` token.
# REQUIRED for the HAPI daily job; generate your own at
# https://hapi.humdata.org/docs (Encode Identifier). Empty ⇒ the HAPI assets
# fail fast (no shared committed token).
HAPI_APP_IDENTIFIER=

# IOM DTM (displacement) — Azure APIM subscription key. Empty ⇒ the monthly DTM
# job fails fast (the daily HAPI job is unaffected). Get one at
# https://dtm-apim.developer.iom.int/.
IOM_DTM_SUBSCRIPTION_KEY=
# IOM_DTM_BASE_URL=https://dtmapi.iom.int/v3   # override only if the API moves
# assessmentType priority: "BA,FM" fills each pcode from BA, then FM for gaps
# (avoids double-counting the two). "BA" = single type; "" = pool all (only safe
# when there's no BA/FM overlap).
IOM_DTM_ASSESSMENT_TYPE=BA,FM
# Per-ISO3 DTM Operation (data-gathering project) overrides as JSON. Unlisted
# countries fetch across all operations. Sudan has one canonical operation:
# IOM_DTM_OPERATIONS={"SDN": "Armed Clashes in Sudan (Overview)"}
IOM_DTM_OPERATIONS={}

# ACAPS Seasonal Events Calendar (monthly job) — the same ACAPS API key CLEAR
# uses for INFORM Severity / Protection Risks. Empty ⇒ the ACAPS asset fails
# fast (DTM + HAPI unaffected). Sent as `Authorization: Token <key>`.
ACAPS_API_KEY=

# Tuning (all optional). clear-api's Postgres is often reached over an SSH
# tunnel, so upserts are chunked by payload BYTES (not row count) to stay under
# the request timeout — big finely-disaggregated blobs (e.g. humanitarian-needs
# PIN, ~100KB each) go a few per chunk, tiny blobs go up to the row cap.
# LOCATION_METADATA_UPSERT_MAX_BYTES=400000   # ~400KB/chunk; lower if upserts time out
# LOCATION_METADATA_UPSERT_CHUNK=50           # row cap per chunk (backstop)
# LOCATION_METADATA_MAX_CONCURRENT=2          # parallel assets per job (HAPI shares one rate limit)

# ─── LLM providers (role-scoped) ────────────────────────────────────
# Two roles, configured independently so you can point them at
# different providers (e.g. cheap Haiku for context, larger Sonnet /
# Llama-70B for structured extraction).
#
# Supported PROVIDER values:
#   anthropic     — native SDK; unlocks prompt caching on the `system`
#                   prompt (used for the doc-level prefix in the
#                   contextualization step).
#   openai_compat — any /v1/chat/completions endpoint. Together AI,
#                   Fireworks, DeepInfra, self-hosted vLLM. Requires
#                   the matching *_BASE_URL to point at the endpoint.
#
# The v1 defaults below are Claude Haiku / Sonnet. To swap to open-
# source Llama-3.3 hosted on Together AI, flip PROVIDER to
# openai_compat, set MODEL to the Together model slug, and set
# BASE_URL to https://api.together.xyz/v1.

# Contextualization (per-chunk; volume × cheap model)
LLM_CONTEXT_PROVIDER=anthropic
LLM_CONTEXT_MODEL=claude-haiku-4-5
LLM_CONTEXT_API_KEY=
# LLM_CONTEXT_BASE_URL=            # REQUIRED only when PROVIDER=openai_compat

# Structured per-chunk tagging (locations / time / event types / sectors).
# Highest-volume LLM call and tolerant (has a validation-repair retry) —
# runs on a cheap model.
LLM_EXTRACTION_PROVIDER=anthropic
LLM_EXTRACTION_MODEL=claude-haiku-4-5
LLM_EXTRACTION_API_KEY=
# LLM_EXTRACTION_BASE_URL=         # REQUIRED only when PROVIDER=openai_compat

# Numeric datapoint extraction (6 domains per report). Accuracy-critical —
# wrong figures = wrong humanitarian data — so it stays on a strong model.
# Unset → falls back to LLM_EXTRACTION_* (see providers/llm.py).
LLM_DATAPOINTS_PROVIDER=anthropic
LLM_DATAPOINTS_MODEL=claude-sonnet-4-6
LLM_DATAPOINTS_API_KEY=
# LLM_DATAPOINTS_BASE_URL=         # REQUIRED only when PROVIDER=openai_compat

# Situation-analysis prose + sector generation. Low volume, high quality
# bar → strong model. Unset → falls back to LLM_EXTRACTION_*.
LLM_NARRATIVE_PROVIDER=anthropic
LLM_NARRATIVE_MODEL=claude-sonnet-4-6
LLM_NARRATIVE_API_KEY=
# LLM_NARRATIVE_BASE_URL=          # REQUIRED only when PROVIDER=openai_compat

# ─── Insights telemetry (LLM call dashboard) ─────────────────────────
# One row per LLM call → clear-pipeline-insights (cost, tokens, latency,
# prompts, parsed output). OFF unless INSIGHTS_INGEST_TOKEN is set; posting is
# fire-and-forget and never affects the pipeline. PIPELINE_ENV labels the run
# on the dashboard (infra sets dev/staging/prod; unset → local-<user>).
INSIGHTS_API_URL=https://clear-pipeline-insights.vercel.app
INSIGHTS_INGEST_TOKEN=
# PIPELINE_ENV=dev

# ─── Resilience: timeout + optional per-role fallback (ADR-0003 §4) ──
# A flaky non-Claude primary (e.g. an OpenRouter/self-hosted endpoint) must
# never stall a batch. Every call is bounded by LLM_TIMEOUT_SECONDS; on a
# provider error, timeout, or EMPTY response the call re-runs once on the
# fallback, and a circuit breaker then routes straight to the fallback while
# the primary keeps failing (auto-recovers after a cooldown).
LLM_TIMEOUT_SECONDS=90
#
# Fallback is OFF unless BOTH FALLBACK_MODEL and FALLBACK_API_KEY are set for a
# role (setting only one logs a warning and stays off). Vars per role:
#   LLM_<ROLE>_FALLBACK_PROVIDER   # anthropic (default) | openai | openai_compat
#   LLM_<ROLE>_FALLBACK_MODEL
#   LLM_<ROLE>_FALLBACK_API_KEY
#   LLM_<ROLE>_FALLBACK_BASE_URL   # REQUIRED only when FALLBACK_PROVIDER=openai_compat
# Like the primaries, datapoints/narrative inherit the extraction role's
# FALLBACK_* when their own are unset. Example — cheap context primary backed
# by Claude Haiku:
# LLM_CONTEXT_FALLBACK_PROVIDER=anthropic
# LLM_CONTEXT_FALLBACK_MODEL=claude-haiku-4-5
# LLM_CONTEXT_FALLBACK_API_KEY=

# ─── Evals (model-replacement eval only; not used by the pipeline) ──
# API key for the free OpenRouter candidate models the eval compares against
# Claude. See evals/README.md. Base URL is fixed to https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=

# ─── Embedding provider ─────────────────────────────────────────────
# Supported PROVIDER values:
#   voyage        — Voyage AI native SDK. Matryoshka-truncates
#                   voyage-3-large to EMBEDDING_DIMENSIONS.
#   openai_compat — Together AI / Fireworks / HuggingFace TEI /
#                   self-hosted vLLM with an embedding model. Requires
#                   EMBEDDING_BASE_URL. Set MODEL to e.g. `BAAI/bge-m3`
#                   for the v2 open-source swap.
#
# EMBEDDING_DIMENSIONS MUST equal the pgvector column dimension in
# clear-api (currently 1024). Changing the column type is a
# coordinated migration.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=              # REQUIRED only when PROVIDER=openai_compat

# Client-side requests-per-minute ceiling. Voyage's free tier caps at
# 3 RPM; the VoyageProvider paces itself under this floor so bursts
# don't produce 429s (each retried request also counts against the
# same window, so unpaced retry loops actively make it worse). Set
# to 0 to disable throttling on paid tiers or self-hosted endpoints.
# Only honoured by voyage today; the openai_compat provider ignores it.
EMBEDDING_RPM_LIMIT=3

# ─── Knowledge-base guardrails ──────────────────────────────────────
# Advisory ceilings enforced by the enrich asset.
#
# KB_MAX_CHUNKS_PER_REPORT: hard cap on chunks per report so a
# malformed PDF that tokenises to tens of thousands of chunks can't
# pin the run against provider rate limits. Default 500.
KB_MAX_CHUNKS_PER_REPORT=500

# KB_MAX_COST_USD_PER_RUN: soft cap across the whole materialisation.
# The RunBudget tracker in providers/guardrails.py exposes this to
# assets that want to check before dispatching further LLM calls.
# Default $5.
KB_MAX_COST_USD_PER_RUN=5.0

# KB_SKIP_CONTEXTUALIZATION: emergency kill-switch. When set (`1` /
# `true`), the enrich asset embeds raw chunk text without the doc-
# level context prefix. Retrieval quality drops noticeably; use only
# when the LLM provider is down or the budget is exhausted.
KB_SKIP_CONTEXTUALIZATION=0

# KB_AGGREGATION_LOOKBACK_DAYS: rolling window (in days) used on
# SUBSEQUENT runs of the aggregation asset once at least one current
# `aggregated_datapoints` row exists for the current schema version.
# The narrow default matches the weekly Dagster cadence. Default 7.
KB_AGGREGATION_LOOKBACK_DAYS=7

# KB_AGGREGATION_INITIAL_LOOKBACK_DAYS: rolling window (in days) used
# on the FIRST run of the aggregation asset — detected by checking
# whether any current aggregation rows exist for the current schema
# version. Wide enough that any historical `report_datapoints`
# already accumulated get folded into the caches on the first pass.
# Default 90.
KB_AGGREGATION_INITIAL_LOOKBACK_DAYS=90

# SITUATION_SKIP_NARRATIVE: emergency kill-switch for the four
# LLM-generated narrative components in the situation-analysis
# generator (AI summary, context risks, hazards/vulnerabilities,
# displacement). When set (`1` / `true`), the generator ships a
# deterministic-only row — Datapoints + Sources populated, LLM
# sections at their empty defaults. Same semantic as
# `KB_SKIP_CONTEXTUALIZATION` for the vector pipeline; use when the
# LLM provider is down or the budget is exhausted so the dashboard
# still gets fresh numbers.
SITUATION_SKIP_NARRATIVE=0

# ─────────────────────────────────────────────────────────────────────────────
# Signal pipeline (ported from clear-pipeline: sources → signals → events →
# alerts → translations). Ingest is per-source; classify/group/alert/translate
# are shared Dagster stages. Sensors ship STOPPED — enable them in the Dagster UI.
# ─────────────────────────────────────────────────────────────────────────────

# Redis — per-source poll watermarks/dedup, the classify_group drain lock, and
# ACLED's session-cookie cache. Defaults to localhost:6379/0; point at your
# instance if it's elsewhere.
REDIS_URL=redis://localhost:6379/0

# Signal LLM role (grouping rewrite + translation fall back to it). Falls back to
# LLM_EXTRACTION_* (haiku) when unset. clear-pipeline ran the rewrite on SONNET —
# set these for faithful grouping quality:
# LLM_SIGNAL_PROVIDER=anthropic
# LLM_SIGNAL_MODEL=claude-sonnet-4-6
# LLM_SIGNAL_API_KEY=
# Translation LLM role — falls back to LLM_EXTRACTION_* (haiku) when unset.
# LLM_TRANSLATE_PROVIDER=anthropic
# LLM_TRANSLATE_MODEL=claude-haiku-4-5
# LLM_TRANSLATE_API_KEY=

# Target locales for the translate stage (comma-separated BCP-47; 'en' is the
# canonical source and is ignored). Empty disables translation.
TARGET_LOCALES=ar,fr

# Each source needs a matching row in clear-api's data_sources table (the
# ingest resolves DataSource id by name). Poll cadence is the sensor default
# (minutes) — editable live via the sensor cursor in the Dagster UI.

# ── Dataminr (real-time alerts) ──
DATAMINR_CLIENT_ID=
DATAMINR_CLIENT_SECRET=
DATAMINR_SOURCE_NAME=dataminr
DATAMINR_POLL_INTERVAL_MINUTES=60

# ── ACLED (armed-conflict events) — session-cookie auth ──
ACLED_USERNAME=
ACLED_PASSWORD=
ACLED_COUNTRIES=Sudan,Afghanistan,Venezuela
ACLED_SOURCE_NAME=acled
ACLED_POLL_INTERVAL_MINUTES=60

# ── GDACS (global disaster alerts) — no auth ──
GDACS_COUNTRIES=Sudan,Afghanistan,Venezuela
GDACS_SOURCE_NAME=gdacs
GDACS_POLL_INTERVAL_MINUTES=30

# ── darfur24 (Sudanese news RSS) — no auth ──
DARFUR24_FEED_URLS=https://darfur24.com/en/feed/
DARFUR24_DEFAULT_COUNTRY=Sudan
DARFUR24_SOURCE_NAME=darfur24
DARFUR24_POLL_INTERVAL_MINUTES=30

# ── IDMC IDU (displacement events) ──
# REQUIRED — request a client_id via IDMC; the endpoint 403s without one.
IDMC_CLIENT_ID=
IDMC_COUNTRIES=SDN,AFG,VEN
IDMC_SOURCE_NAME=idmc
IDMC_POLL_INTERVAL_MINUTES=1440

# ── Manual (analyst-created in clear-api; no poll) ──
# The classify_group stage drains these via a sensor every N minutes.
MANUAL_SOURCE_NAME=manual
MANUAL_POLL_INTERVAL_MINUTES=1
