# dagster-quickstart environment variables.
#
# Copy this file to `.env` and fill in real values. Every entry marked
# REQUIRED must be set or the corresponding asset will refuse to start.
# Optional entries fall back to the defaults noted alongside.
#
# The file is loaded via python-dotenv from the dagster-quickstart repo
# root (see load_dotenv(...) calls in each asset module).

# ─── ReliefWeb ingest ────────────────────────────────────────────────
# App name registered with ReliefWeb's API. Any non-empty string works
# for public endpoints; they use it for rate-limiting / analytics.
RELIEFWEB_APPNAME=

# ─── S3 / object store ──────────────────────────────────────────────
# Any S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO, etc.). All
# five values are REQUIRED — the assets fail loud on missing creds
# rather than silently swallowing writes.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── clear-api ──────────────────────────────────────────────────────
# All DB access (location resolver + knowledgebase upsert) routes
# through clear-api's GraphQL, matching the clear-pipeline pattern.
# CLEAR_API_KEY must belong to a user with the `admin` or `pipeline`
# role — issue one via `createApiKey` in clear-api. REQUIRED.
CLEAR_API_URL=http://localhost:4000/graphql
CLEAR_API_KEY=

# ─── LLM providers (role-scoped) ────────────────────────────────────
# Two roles, configured independently so you can point them at
# different providers (e.g. cheap Haiku for context, larger Sonnet /
# Llama-70B for structured extraction).
#
# Supported PROVIDER values:
#   anthropic     — native SDK; unlocks prompt caching on the `system`
#                   prompt (used for the doc-level prefix in the
#                   contextualization step).
#   openai_compat — any /v1/chat/completions endpoint. Together AI,
#                   Fireworks, DeepInfra, self-hosted vLLM. Requires
#                   the matching *_BASE_URL to point at the endpoint.
#
# The v1 defaults below are Claude Haiku / Sonnet. To swap to open-
# source Llama-3.3 hosted on Together AI, flip PROVIDER to
# openai_compat, set MODEL to the Together model slug, and set
# BASE_URL to https://api.together.xyz/v1.

# Contextualization (per-chunk; volume × cheap model)
LLM_CONTEXT_PROVIDER=anthropic
LLM_CONTEXT_MODEL=claude-haiku-4-5
LLM_CONTEXT_API_KEY=
# LLM_CONTEXT_BASE_URL=            # REQUIRED only when PROVIDER=openai_compat

# Structured parameter extraction (per-chunk; needs solid JSON mode)
LLM_EXTRACTION_PROVIDER=anthropic
LLM_EXTRACTION_MODEL=claude-sonnet-4-6
LLM_EXTRACTION_API_KEY=
# LLM_EXTRACTION_BASE_URL=         # REQUIRED only when PROVIDER=openai_compat

# ─── Embedding provider ─────────────────────────────────────────────
# Supported PROVIDER values:
#   voyage        — Voyage AI native SDK. Matryoshka-truncates
#                   voyage-3-large to EMBEDDING_DIMENSIONS.
#   openai_compat — Together AI / Fireworks / HuggingFace TEI /
#                   self-hosted vLLM with an embedding model. Requires
#                   EMBEDDING_BASE_URL. Set MODEL to e.g. `BAAI/bge-m3`
#                   for the v2 open-source swap.
#
# EMBEDDING_DIMENSIONS MUST equal the pgvector column dimension in
# clear-api (currently 1024). Changing the column type is a
# coordinated migration.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=              # REQUIRED only when PROVIDER=openai_compat

# Client-side requests-per-minute ceiling. Voyage's free tier caps at
# 3 RPM; the VoyageProvider paces itself under this floor so bursts
# don't produce 429s (each retried request also counts against the
# same window, so unpaced retry loops actively make it worse). Set
# to 0 to disable throttling on paid tiers or self-hosted endpoints.
# Only honoured by voyage today; the openai_compat provider ignores it.
EMBEDDING_RPM_LIMIT=3

# ─── Knowledge-base guardrails ──────────────────────────────────────
# Advisory ceilings enforced by the enrich asset.
#
# KB_MAX_CHUNKS_PER_REPORT: hard cap on chunks per report so a
# malformed PDF that tokenises to tens of thousands of chunks can't
# pin the run against provider rate limits. Default 500.
KB_MAX_CHUNKS_PER_REPORT=500

# KB_MAX_COST_USD_PER_RUN: soft cap across the whole materialisation.
# The RunBudget tracker in providers/guardrails.py exposes this to
# assets that want to check before dispatching further LLM calls.
# Default $5.
KB_MAX_COST_USD_PER_RUN=5.0

# KB_SKIP_CONTEXTUALIZATION: emergency kill-switch. When set (`1` /
# `true`), the enrich asset embeds raw chunk text without the doc-
# level context prefix. Retrieval quality drops noticeably; use only
# when the LLM provider is down or the budget is exhausted.
KB_SKIP_CONTEXTUALIZATION=0

# KB_AGGREGATION_LOOKBACK_DAYS: rolling window (in days) used on
# SUBSEQUENT runs of the aggregation asset once at least one current
# `aggregated_datapoints` row exists for the current schema version.
# The narrow default matches the weekly Dagster cadence. Default 7.
KB_AGGREGATION_LOOKBACK_DAYS=7

# KB_AGGREGATION_INITIAL_LOOKBACK_DAYS: rolling window (in days) used
# on the FIRST run of the aggregation asset — detected by checking
# whether any current aggregation rows exist for the current schema
# version. Wide enough that any historical `report_datapoints`
# already accumulated get folded into the caches on the first pass.
# Default 90.
KB_AGGREGATION_INITIAL_LOOKBACK_DAYS=90
